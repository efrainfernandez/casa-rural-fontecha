# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env

# PostgreSQL. Cambia usuario, contraseña, host, puerto y nombre de base de datos.
DATABASE_URL=postgresql://postgres:password@localhost:5432/casa_rural_fontecha

# Secreto de Better Auth. Debe tener al menos 32 caracteres.
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# URL pública del API (apps/server).
BETTER_AUTH_URL=http://localhost:3000

# Origen permitido por CORS. Debe coincidir con la URL de la web (apps/web).
CORS_ORIGIN=http://localhost:3001

# Opcional. Por defecto: development
# NODE_ENV=development
